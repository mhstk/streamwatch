{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/hooks/useAuth": ["src/platform/useAuth.ts"],
      "@/lib/auth": ["src/platform/auth.ts"],
      "@/*": ["../src/*"],
      "~/*": ["src/*"]
    },
    "types": ["chrome"]
  },
  "include": ["src"]
}
